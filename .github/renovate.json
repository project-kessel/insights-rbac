{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "master"
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": ">=3.12 <3.13",
      "description": "Keep CI on the application's supported Python minor version"
    },
    {
      "matchPackageNames": [
        "boto3"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false,
      "description": "Skip patch updates for boto3 (e.g., 1.1.1 → 1.1.2)"
    }
  ]
}
