# Docker Compose network: database service address (not reachable from the host).
DATABASE_NAME=postgres
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Local Python with PostgreSQL published on host port 15432: replace the
# DATABASE_* values above with these (do not leave duplicate active entries).
# DATABASE_NAME=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=15432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres

# Redis: local Python defaults to localhost:6379 in Django settings.
# The Compose server defaults to rbac_redis:6379; its worker uses redis:6379.
# If REDIS_HOST is overridden, change it when switching run modes.
# REDIS_HOST=localhost
# REDIS_PORT=6379

API_PATH_PREFIX=/api/rbac

DEVELOPMENT=True
DJANGO_DEBUG=True

# V2 defaults
SYSTEM_DEFAULT_ROOT_WORKSPACE_ROLE_UUID=23592f00-71f7-482d-be2c-e82eeb704406
SYSTEM_DEFAULT_TENANT_ROLE_UUID=d8e9d8c6-1edf-41b8-951d-805e9e701f49
SYSTEM_ADMIN_ROOT_WORKSPACE_ROLE_UUID=411ef1a0-75a8-4765-8e9f-377297e8ee28
SYSTEM_ADMIN_TENANT_ROLE_UUID=a62b9113-593d-471b-96aa-971d6e748a9b
WORKSPACE_HIERARCHY_DEPTH_LIMIT=5
WORKSPACE_ORG_CREATION_LIMIT=20000000
V2_APIS_ENABLED=True
V2_READ_ONLY_API_MODE=False
# Fallback for rbac.ocm-v2.enabled, independent of workspace activation
OCM_V2_ENABLED=False
V2_BOOTSTRAP_TENANT=True
WORKSPACE_HIERARCHY_ENABLED=True

# Kafka settings (for local testing)
# Set to False to disable Kafka and avoid KAFKA_AUTH errors during unit tests
# Set to True when running integration tests with docker-compose Kafka
KAFKA_ENABLED=False

# Optional Kafka settings (only needed when KAFKA_ENABLED=True)
# KAFKA_SERVERS=localhost:9092
# PRINCIPAL_CLEANUP_DELETION_ENABLED_KAFKA=False
# PRINCIPAL_CLEANUP_UPDATE_ENABLED_KAFKA=False
# KAFKA_PRINCIPAL_CLEANUP_JOB_ENABLED=True
